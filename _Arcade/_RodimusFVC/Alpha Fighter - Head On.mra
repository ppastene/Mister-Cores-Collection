    <num_buttons>3</num_buttons>
    <buttons names="Fire,-,Game Select,-,Coin,Start 1P,Start 2P,Pause,-,-,-" default="A,X,Select,Start,R,L"/>

    <switches default="E0">
        <dip name="Alpha Fighter Lives" bits="0,1" ids="3,4,5,6"/>
        <dip name="Head On Lives" bits="4" ids="3,4"/>
        <dip name="Alpha Fighter Bonus Life" bits="2" ids="1000,1500"/>
        <dip name="Alpha Fighter Final UFO Bonus" bits="3" ids="Off,On" values="1,0"/>
    </switches>

