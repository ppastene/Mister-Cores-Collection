<misterromdescription>
    <name>Breakout</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Breakout</series>
    <year>1976</year>
    <manufacturer>Atari</manufacturer>
    <category>Breakout</category>

    <setname>breakout</setname>
    <parent>breakout</parent>
    <mameversion></mameversion>
    <rbf>Pong</rbf>
    <about>Discrete TTL board compiled from MAME's nl_breakout.cpp netlist (tools/dlogic)</about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>no</flip>

    <players>2 (alternating)</players>
    <joystick></joystick>
    <special_controls>paddle</special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Serve,-,-,-,Coin,Start 1P,Start 2P,Pause" default="A,Select,Start,R,L"/>

    <switches default="00">
        <dip name="Free Play" bits="0,3" ids="No Free Play,100,200,300,400,500,600,700,800"/>
        <dip name="Cabinet" bits="4" ids="Cocktail,Upright"/>
        <dip name="Coinage" bits="5" ids="1C/1C,1C/2C"/>
        <dip name="Balls" bits="6" ids="3,5"/>
    </switches>

